{
  "name": "@haoyi/franchise-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:ui-spec": "vite --config vite.ui-spec.config.ts --host 127.0.0.1 --port 5174 --strictPort --open /ui-spec.html",
    "build:ui-spec": "tsc -b && vite build --config vite.ui-spec.config.ts",
    "preview:ui-spec": "vite preview --config vite.ui-spec.config.ts --host 127.0.0.1 --port 4174 --strictPort --open /ui-spec.html",
    "preview:visual": "node ../../scripts/preview-visual.cjs",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "tsc -b && vite build --config vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "oidc-client-ts": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.10.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}

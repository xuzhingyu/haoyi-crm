# Copy to infra/.env and replace every change-me value before deployment.
PORTAL_DOMAIN=portal.crm.example.com
CRM_DOMAIN=crm.crm.example.com
AUTH_DOMAIN=auth.crm.example.com

POSTGRES_SUPERUSER=platform_admin
POSTGRES_SUPERUSER_PASSWORD=change-me-long-random
LEAD_CORE_DB_PASSWORD=change-me-long-random
KEYCLOAK_DB_PASSWORD=change-me-long-random
TWENTY_DB_PASSWORD=change-me-long-random

KEYCLOAK_ADMIN=platform-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-long-random
KEYCLOAK_HOSTNAME=https://auth.crm.example.com

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LEAD_CORE_SENSITIVE_DATA_KEY=change-me-fernet-key
LEAD_CORE_PERSON_FIELDS_ENABLED=false

TWENTY_SERVER_URL=https://crm.crm.example.com
TWENTY_APP_SECRET=change-me-32-plus-characters
TWENTY_ENCRYPTION_KEY=change-me-32-plus-characters
TWENTY_FALLBACK_ENCRYPTION_KEY=change-me-32-plus-characters
TWENTY_API_KEY=change-me-after-creating-the-twenty-api-key

MINIO_ROOT_USER=object_admin
MINIO_ROOT_PASSWORD=change-me-long-random

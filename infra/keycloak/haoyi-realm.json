{
  "realm": "haoyi",
  "enabled": true,
  "displayName": "好易拓客",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": true,
  "organizationsEnabled": true,
  "roles": {
    "realm": [
      { "name": "franchise_owner" },
      { "name": "franchise_member" },
      { "name": "hq_admin" },
      { "name": "hq_franchise_manager" },
      { "name": "hq_data_reviewer" },
      { "name": "hq_auditor" }
    ]
  },
  "clients": [
    {
      "clientId": "franchise-portal",
      "name": "加盟商拓客门户",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://portal.crm.example.com/*", "http://localhost:5173/*"],
      "webOrigins": ["https://portal.crm.example.com", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email", "org-context", "lead-core-audience"]
    },
    {
      "clientId": "lead-core",
      "name": "Lead Core API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true
    }
  ],
  "clientScopes": [
    {
      "name": "org-context",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "organization-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "lead-core-audience",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "lead-core-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "lead-core",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "smtpServer": {}
}

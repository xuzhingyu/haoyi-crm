FROM node:24-trixie-slim
WORKDIR /app
COPY vendor/aihot/ ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund --registry=https://registry.npmmirror.com
COPY infra/deploy/aihot-sources.json ./industry/sources.json
ENV NODE_ENV=production NODE_OPTIONS=--max-old-space-size=128
RUN mkdir -p /data && chown -R node:node /app /data
USER node
CMD ["node", "apps/api/src/main.ts"]
